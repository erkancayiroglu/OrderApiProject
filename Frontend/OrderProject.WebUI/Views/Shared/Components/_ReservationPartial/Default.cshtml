@model Create2BookingDto

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center">
          
            <h1 class="mb-5"><span class="" style="color:darkblue">Rezervasyon</span> Formu</h1>
        </div>
        <div id="bookingContainer">
        <form id="bookingForm">
          
            <div class="row g-3">

             
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Name" placeholder="Adınız Soyadınız">
                        <label>Adınız Soyadınız</label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

               
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="email" class="form-control" asp-for="UserMail" placeholder="Mail Adresiniz">
                        <label>Mail Adresiniz</label>
                        <span asp-validation-for="UserMail" class="text-danger"></span>
                    </div>
                </div>

            
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="PhoneNumber" placeholder="Telefon Numaranız">
                        <label>Telefon Numaranız</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="date" class="form-control" asp-for="BookingDay">
                        <label>Rezervasyon Tarihi</label>
                    </div>
                </div>

            
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="time" class="form-control" asp-for="BookingTime">
                        <label>Rezervasyon Saati</label>
                    </div>
                </div>

              
                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" asp-for="RestaurantName" asp-items="ViewBag.RestaurantNameList"></select>
                        <label>Kebapçı Seçin</label>
                    </div>
                </div>

         
                <div class="col-12">
                    <div class="form-floating">
                        <input type="number" class="form-control" asp-for="NumberOfPeople" min="1" placeholder="Kişi Sayısı">
                        <label>Kişi Sayısı</label>
                    </div>
                </div>

           
                <div class="col-12">
                    <div class="form-floating">
                        <textarea class="form-control" asp-for="Message" style="height:120px;"></textarea>
                        <label>Not / Özel İstek</label>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                </div>

         
                <div class="col-12">
                    <button class="btn btn-dark w-100 py-3" type="submit">Rezervasyon Yap</button>
                </div>

            </div>
        </form>
        </div>
   
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $("#bookingForm").submit(function (e) {
            e.preventDefault(); // Form gönderimini durdur

            var formData = {
                Name: $("#Name").val(),
                UserMail: $("#UserMail").val(),
                PhoneNumber: $("#PhoneNumber").val(),
                BookingDay: $("#BookingDay").val(),
                BookingTime: $("#BookingTime").val(),
                RestaurantName: $("#RestaurantName").val(),
                NumberOfPeople: $("#NumberOfPeople").val(),
                Message: $("#Message").val()
            };

            $.ajax({
                url: '/Booking/AddBooking',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function () {
                    // Formu içeren container'ı tamamen değiştir
                    $("#bookingContainer").html(`
                        <h2 style="color:green; font-size:2rem; font-weight:bold; text-align:center;">
                            ✅ REZERVASYON BAŞVURUNUZ İLETİLDİ
                        </h2>
                    `);
                },
                error: function (xhr, status, error) {
                    alert("Bir hata oluştu: " + error);
                }
            });
        });
    });
</script>